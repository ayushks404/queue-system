generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  password_hash String
  name          String
  phone         String?
  role          String   @default("CUSTOMER")
  created_at    DateTime @default(now())

  @@map("users")
}
