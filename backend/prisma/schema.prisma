generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  password_hash String
  name          String
  phone         String?
  role          String   @default("CUSTOMER")
  created_at    DateTime @default(now())

  @@map("users")
}

model Branch {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  address        String
  phone          String
  is_active      Boolean        @default(true)
  business_hours BusinessHour[]
  holidays       Holiday[]
  resources      Resource[]

  @@map("branches")
}

model BusinessHour {
  id          String  @id @default(uuid()) @db.Uuid
  branch_id   String  @db.Uuid
  day_of_week Int
  open_time   String
  close_time  String
  break_start String?
  break_end   String?
  branch      Branch  @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@map("business_hours")
}

model Holiday {
  id           String   @id @default(uuid()) @db.Uuid
  branch_id    String   @db.Uuid
  holiday_date DateTime @db.Date
  reason       String?
  branch       Branch   @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@map("holidays")
}

model Service {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  duration_minutes  Int
  price             Decimal           @db.Decimal(10, 2)
  capacity          Int               @default(1)
  is_active         Boolean           @default(true)
  service_resources ServiceResource[]

  @@map("services")
}

model Resource {
  id        String  @id @default(uuid()) @db.Uuid
  branch_id String  @db.Uuid
  name      String
  type      String
  is_active Boolean @default(true)
  branch    Branch  @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@map("resources")
}

model ServiceResource {
  id            String  @id @default(uuid()) @db.Uuid
  service_id    String  @db.Uuid
  resource_type String
  service       Service @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@map("service_resources")
}
